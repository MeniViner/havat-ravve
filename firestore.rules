   allow delete: if isStaff();
  }
  // S6, S7: a shopping trip. Only the shopper writes it; a manager may delete it (the items keep what happened to them)
  match /shopping_trips/{id} {
   function tripShape(){return incoming().keys().hasOnly(['id','by','list','startedAt','closedAt','bought','missing','recipientUids']) && incoming().get('id', id) == id && shoppingCategory(incoming().list) && (incoming().get('recipientUids', []) is list && incoming().get('recipientUids', []).size() <= 2000) && str(incoming().startedAt, 40) && (incoming().closedAt == null || str(incoming().closedAt, 40)) && incoming().bought is list && incoming().bought.size() <= 200 && incoming().missing is list && incoming().missing.size() <= 200;}
   allow read: if isStaff();
   allow create: if isStaff() && tripShape() && actorOk(incoming().by) && incoming().closedAt == null;
   allow update: if isStaff() && tripShape() && resource.data.by.uid == uid() && incoming().by == resource.data.by && incoming().startedAt == resource.data.startedAt && incoming().list == resource.data.list && !changed().hasAny(['recipientUids']);
   allow delete: if isManager();
  }
  // The assistant log ("יומן אינסטינקט"): one entry per API request, written only by the API Worker (service account). Owners only.
  match /api_log/{id} {
   allow read: if isOwner();
   allow write: if false;
  }
  // Personal settings activity. The client can append only a fixed event code for its own account.
  match /account_activity/{id} {
   allow read: if isOwner();
   allow create: if signed() && incoming().keys().hasOnly(['uid','action','at']) && incoming().uid == uid()
     && incoming().action in ['profile_updated','photo_updated','welcome_completed','updates_changed','push_changed'] && isoTime(incoming().at);
   allow update, delete: if false;
