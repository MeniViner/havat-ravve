     && (!('unsuitableModes' in d) || (d.unsuitableModes is list && d.unsuitableModes.size()<=3 && d.unsuitableModes.hasOnly(['walk','bike','vehicle']) && !d.unsuitableModes.hasAny(d.modes)))
     && d.connections is list && d.connections.size()<=32
