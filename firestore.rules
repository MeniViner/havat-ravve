   function coordinates(p){return p.lat is number && p.lat >= -90 && p.lat <= 90 && p.lng is number && p.lng >= -180 && p.lng <= 180;}
   function placeExtras(){let p=incoming(); let a=p.get('accuracy',null); return photoOk(p.get('photo','')) && (a == null || (a is number && a >= 0)) && coordinates(p)
     && p.get('icon','pin') in ['pin','gate','sprout','tree','paw','box','flower','store']
     && p.get('markerStyle','icon') in ['icon','thumbnail'] && str(p.name,120) && p.name.size()>0 && ((p.get('source',null) == null && p.get('measuredAt',null) == null) || (p.source in ['gps','manual'] && p.measuredAt is int && p.measuredAt > 0));}
