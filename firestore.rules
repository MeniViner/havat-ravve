   allow create: if (signed() || joinedInBatch()) && incoming().keys().hasOnly(['kind','refId','action','text','by','at','subjectUid','eventId']) && incoming().kind in ['task','task_private','shopping','event','ticket','tab','place','visit','donation','user','settings','project','message','calendar','calendar_private','inbox'] && (!(incoming().kind in ['project','message','calendar_private','inbox']) || isManager()) && (incoming().kind != 'calendar' || isStaff()) && str(incoming().refId, 80) && str(incoming().action, 40) && str(incoming().text, 500) && actorOk(incoming().by) && str(incoming().at, 40) && str(incoming().subjectUid, 60) && str(incoming().eventId, 60)
     && (!helperInviteCode(id) || !exists(vendorInvitePath(id)) || helperRemovalLog());
