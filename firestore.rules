   function projectShape(){return incoming().keys().hasOnly(['id','eventId','title','goal','deadline','deadlineText','short','members','memberUids','status','doneAt','createdBy','createdAt','updatedAt']) && str(incoming().get('eventId', ''), 80) && (incoming().get('eventId', '') == '' || existsAfter(/databases/$(database)/documents/events/$(incoming().eventId))) && incoming().get('id', pid) == pid && str(incoming().title, 120) && incoming().title.size() > 0 && str(incoming().get('goal', ''), 120) && str(incoming().get('deadline', ''), 10) && str(incoming().get('deadlineText', ''), 60) && str(incoming().get('short', ''), 40) && incoming().get('members', []) is list && incoming().get('members', []).size() <= 50 && incoming().get('memberUids', []) is list && incoming().get('memberUids', []).size() <= 50 && incoming().status in ['active','done'] && optIso('doneAt') && str(incoming().updatedAt, 40);}
   allow read: if isManager() || (isStaff() && resource.data.eventId is string && resource.data.eventId != '');
   allow create: if isManager() && projectShape() && incoming().status == 'active' && actorOk(incoming().createdBy) && str(incoming().createdAt, 40);
