    && incoming().get('appliedEventIds', []) is list && incoming().get('appliedEventIds', []).size() <= 500;
  }
  // Event end as stored by the app (UTC), older API clocks (Jerusalem wall time), or an explicit numeric offset.
  function jerusalemOffset(wall){
   let y = wall.year();
   let mar = timestamp.date(y, 3, 31);
   let oct = timestamp.date(y, 10, 31);
   let summer = mar - duration.value(mar.dayOfWeek() % 7 + 2, 'd') + duration.value(2, 'h');
   let winter = oct - duration.value(oct.dayOfWeek() % 7, 'd') + duration.value(2, 'h');
   return wall >= summer && wall < winter ? 180 : 120;
  }
  function eventOffset(s, wall){
