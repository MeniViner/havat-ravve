     && (get(registry).data.moving == null || get(registry).data.moving.from != sid));
  }
  function movingStation(sid){
   let registry = /databases/$(database)/documents/work_stations/farm;
   return exists(registry) && get(registry).data.moving != null && get(registry).data.moving.from == sid
     && get(registry).data.moving.to != '';
  }
  function transferredPeople(eventId,sid){
