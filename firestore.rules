   // Legacy approvals stored their public reply in managerNote. Visits with a dedicated reply keep staff notes private.
   function publicNoteOk(){return (!('replyText' in resource.data) || 'replyText' in incoming())
     && (!changed().hasAny(['managerNote']) || incoming().managerNote == '' || (!('replyText' in resource.data) && !('replyText' in incoming())));}
   allow update: if visitShape() && incoming().uid == resource.data.uid && ((isManager() && publicNoteOk() && changed().hasOnly(['status','managerNote','handledBy','updatedAt','requestedDate','approvedDate','approvedTime','replyText','replyChannel']) && actorOk(incoming().handledBy)) || (mine('uid') && changed().hasOnly(['status','updatedAt']) && resource.data.status == 'new' && incoming().status == 'cancelled'));
   allow delete: if isManager();
   match /private/{noteId} {
    function currentVisit(){return exists(/databases/$(database)/documents/visits/$(id));}
    allow get: if noteId == 'staff' && isManager() && currentVisit();
    allow create, update: if noteId == 'staff' && isManager() && currentVisit()
      && incoming().keys().hasOnly(['note','updatedAt']) && str(incoming().note, 1000) && isoTime(incoming().updatedAt);
    allow delete: if noteId == 'staff' && isManager();
   }
  }
  match /donations/{id} {
   function donationShape(){return incoming().keys().hasOnly(['uid','name','phone','amount','label','note','memorial','receiptWanted','receiptName','receiptSent','paymentStatus','paymentConfirmation','paidAt','createdAt','updatedAt']) && str(incoming().name, 80) && str(incoming().phone, 25) && incoming().amount is number && incoming().amount > 0 && incoming().amount <= 1000000 && str(incoming().label, 100) && str(incoming().note, 2000) && str(incoming().memorial, 500) && incoming().receiptWanted is bool && str(incoming().receiptName, 120) && incoming().receiptSent is bool && incoming().paymentStatus in ['pending','claimed','paid','cancelled'] && str(incoming().createdAt, 40) && str(incoming().updatedAt, 40);}
   allow read: if isManager() || mine('uid');
   allow create: if signed() && donationShape() && !('paymentConfirmation' in incoming()) && !('paidAt' in incoming()) && incoming().uid == uid() && incoming().paymentStatus == 'pending' && incoming().receiptSent == false;
   allow update: if donationShape() && incoming().uid == resource.data.uid && incoming().amount == resource.data.amount && paidAtOk(incoming().paymentStatus == 'paid') && ((isManager() && (changed().hasOnly(['paymentStatus','receiptSent','paidAt','updatedAt']) || (resource.data.paymentStatus == 'paid' && marksConfirmation()))) || (mine('uid') && changed().hasOnly(['paymentStatus','updatedAt']) && resource.data.paymentStatus == 'pending' && incoming().paymentStatus == 'claimed'));
   allow delete: if isManager();
  }
  match /vendors/{id} {
   function poolShape(){return incoming().keys().hasOnly(['name','phone','product','external','notes','createdAt','updatedAt','contact','sells','needs','note','photo','events','people','inviteNext','fem']) && str(incoming().name, 200) && incoming().name.size() >= 1 && str(incoming().phone, 25) && str(incoming().get('product', ''), 300) && str(incoming().get('sells', ''), 300) && str(incoming().get('contact', ''), 80) && incoming().get('external', true) is bool && incoming().get('fem', false) is bool && str(incoming().get('notes', ''), 2000) && str(incoming().get('note', ''), 1000) && incoming().get('needs', []) is list && incoming().get('needs', []).size() <= 5 && incoming().get('events', []) is list && incoming().get('events', []).size() <= 300 && incoming().get('people', []) is list && incoming().get('people', []).size() <= 12 && photoOk(incoming().get('photo', '')) && incoming().get('inviteNext', false) is bool;}
   // D2, D7, D9, D10: the owner edits what the farm shows about the stall, never the farm's fields
   function ownerEdit(){return changed().hasOnly(['name','phone','product','sells','needs','note','photo','inviteNext','updatedAt']) && vendorOwner(id);}
   function helperAdded(before, after){
    let row = after[before.size()];
    let code = row.get('code', '');
    let path = vendorInvitePath(code);
    return after == before.concat([row]) && row.role == 'helper' && row.get('uid', '') == ''
      && helperInviteCode(code) && !exists(path) && getAfter(path).data.vendorId == id
      && getAfter(path).data.role == 'helper' && getAfter(path).data.active == true;
   }
   function helperRemoved(before, after){
    let missing = before.removeAll(after);
    let code = missing[0].get('code', '');
    return helperRowRemoved(before, after, code) && helperInviteCode(code)
      && helperInviteClosed(code, id, missing[0].get('uid', ''))
      && !exists(removalLogPath(code)) && existsAfter(removalLogPath(code));
   }
   function ownerPeople(){
    let before = stallRows(resource.data);
    let after = stallRows(incoming());
    return changed().hasOnly(['people','updatedAt']) && vendorOwner(id)
      && ((after.size() == before.size() + 1 && helperAdded(before, after))
        || (after.size() + 1 == before.size() && helperRemoved(before, after)));
   }
   allow get: if isStaff() || vendorPerson(id);
   allow list: if isStaff();
   allow create: if isManager() && poolShape();
   allow update: if poolShape() && (ownerEdit() || ownerPeople() || isManager());
   allow delete: if isManager();
   // the team's notes about a vendor (V2 "הערות לצוות"): never readable by the vendor
   match /private/{doc} {
    allow read: if isManager();
    allow write: if isManager() && doc == 'main' && (request.method == 'delete' || (incoming().keys().hasOnly(['notes','updatedAt']) && str(incoming().notes, 2000)));
   }
  }
  // access links (V2/N8 invite, V6, D8): the code is the secret; claiming one makes a vendor profile (users rules)
  match /vendor_invites/{code} {
   function vInviteShape(){return incoming().keys().hasOnly(['code','vendorId','vendorName','role','name','phone','fem','active','usedBy','usedAt','createdBy','createdAt']) && incoming().code == code && code.matches('[a-z0-9-]{8,40}') && str(incoming().vendorId, 60) && incoming().vendorId.size() > 0 && str(incoming().vendorName, 200) && incoming().role in ['owner','helper'] && str(incoming().name, 80) && incoming().name.size() >= 1 && str(incoming().phone, 25) && incoming().get('fem', false) is bool && incoming().active is bool && isoTime(incoming().createdAt);}
   allow get: if google();
   allow list: if isManager() || vendorOwner(resource.data.vendorId);
   allow create: if vInviteShape() && actorOk(incoming().createdBy) && incoming().active == true && incoming().usedBy == null && incoming().usedAt == null && (isManager() || (vendorOwner(incoming().vendorId) && incoming().role == 'helper'));
   allow update: if vInviteShape()
     && ((changed().hasOnly(['active']) && incoming().active == false && (isManager() || (vendorOwner(resource.data.vendorId) && resource.data.role == 'helper' && helperRemovedFrom(resource.data.vendorId, code))))
      || (google() && resource.data.active == true && resource.data.usedBy == null && changed().hasOnly(['usedBy','usedAt','active']) && incoming().usedBy == uid() && incoming().active == false && isoTime(incoming().usedAt) && getAfter(userPath()).data.get('inviteCode', '') == code && getAfter(userPath()).data.role == 'vendor'));
   allow delete: if isManager();
  }
  match /tabs/{id} {
   function tabShape(){return incoming().keys().hasOnly(['eventId','eventTitle','guestUid','guestName','guestPhone','ticketId','items','total','status','createdBy','paymentConfirmation','paidAt','createdAt','updatedAt','reminderSentAt','claimedAt']) && str(incoming().eventId, 60) && str(incoming().eventTitle, 200) && str(incoming().guestUid, 60) && str(incoming().guestName, 80) && str(incoming().guestPhone, 25) && str(incoming().ticketId, 60) && incoming().items is list && incoming().items.size() <= 500 && incoming().total is number && incoming().total >= 0 && incoming().status in ['open','claimed','paid','waived'] && str(incoming().createdAt, 40) && str(incoming().updatedAt, 40) && optIso('reminderSentAt') && optIso('claimedAt');}
   function standaloneLine(eid, row) {
    let product = get(/databases/$(database)/documents/events/$(eid)/products/$(row.productId)).data;
    return product.get('active',true) == true && !product.keys().hasAny(['catalogId','catalogProductId'])
      && row.price == product.price && row.name == product.name && row.qty is int && row.qty > 0 && actorOk(row.by);
   }
   function addsOneStandalone(eid, before, after) {
    let last = after[after.size()-1];
    return resource.data.status == 'open' && incoming().status == 'open' && after == before.concat([last]) && standaloneLine(eid,last)
      && incoming().total >= resource.data.total + last.qty*last.price - 0.005
      && incoming().total <= resource.data.total + last.qty*last.price + 0.005;
   }
   function saleChangeAllowed() {
    let before = resource.data.items;
    let after = incoming().items;
    let eid = resource.data.eventId;
    return !changed().hasAny(['items','total'])
      || !existsAfter(/databases/$(database)/documents/events/$(eid)/stall_config/catalog)
      || (after.size() < before.size() && after == before.removeAll(before.removeAll(after)) && incoming().total <= resource.data.total)
      || (after.size() == before.size()+1 && addsOneStandalone(eid,before,after));
   }
   allow read: if isStaff() || mine('guestUid');
   allow create: if isStaff() && tabShape() && !('paymentConfirmation' in incoming()) && !('paidAt' in incoming()) && !incoming().keys().hasAny(['reminderSentAt','claimedAt']) && actorOk(incoming().createdBy) && incoming().status == 'open' && incoming().items.size() == 0 && incoming().total == 0 && (isManager() || eventOpen(incoming().eventId));
   allow update: if tabShape() && incoming().eventId == resource.data.eventId && saleChangeAllowed()
    && incoming().createdBy == resource.data.createdBy && incoming().guestUid == resource.data.guestUid && paidAtOk(incoming().status == 'paid') && ((isManager() && (!changed().hasAny(['paymentConfirmation']) || (resource.data.status == 'paid' && resource.data.total > 0 && marksConfirmation()))) || (isStaff() && changed().hasOnly(['items','total','updatedAt']) && eventOpen(resource.data.eventId)) || (isStaff() && changed().hasOnly(['status','paidAt','updatedAt']) && resource.data.status in ['open','claimed'] && incoming().status == 'paid' && eventOpen(resource.data.eventId)) || (mine('guestUid') && changed().hasOnly(['status','claimedAt','updatedAt']) && resource.data.status == 'open' && incoming().status == 'claimed'));
   allow delete: if isManager();
  }
  // The write-only contact Worker creates correspondence records. Only managers can read their reply details.
  match /contact_people/{id} { allow read: if isManager(); }
  match /notifications/{id} {
   allow read: if isManager();
   allow create: if signed() && incoming().keys().hasOnly(['type','title','text','link','refId','createdAt','handled','handledBy','handledAt']) && incoming().type in ['visit','donation','join','order','receipt','tab','claim','contact'] && str(incoming().title, 200) && str(incoming().text, 500) && str(incoming().link, 300) && str(incoming().refId, 80) && (incoming().type != 'contact' || (incoming().refId == uid() && incoming().link == '/manage/inbox' && incoming().title.size() > 0 && incoming().text.size() > 0 && isoTime(incoming().createdAt))) && incoming().handled == false && incoming().handledBy == null && incoming().handledAt == null;
   allow update: if isManager() && changed().hasOnly(['handled','handledBy','handledAt']);
   allow delete: if isManager();
  }
  match /calendar/{id} {
   // presence, team items (C11, with an audience, participants and a reminder the Worker sends), visits and events
   function calendarShape(){return incoming().keys().hasOnly(['ownerUid','ownerName','title','date','time','kind','refId','createdAt','from','to','note','audience','participants','reminder','remindAt','reminderSentAt']) && str(incoming().title, 200) && str(incoming().date, 10) && str(incoming().time, 11) && incoming().kind in ['manual','visit','event','presence','meeting','planning'] && str(incoming().get('from', ''), 5) && str(incoming().get('to', ''), 5) && str(incoming().get('note', ''), 200) && incoming().get('audience', 'all') in ['all','managers'] && incoming().get('participants', []) is list && incoming().get('participants', []).size() <= 30 && incoming().get('reminder', '') in ['', '60'] && str(incoming().get('remindAt', ''), 40) && (incoming().get('reminderSentAt', null) == null || str(incoming().reminderSentAt, 40));}
   function ownsPresence(){return isStaff() && resource.data.kind == 'presence' && resource.data.ownerUid == uid();}
   // a volunteer's own presence carries no manager fields
   function createsPresence(){return isStaff() && incoming().kind == 'presence' && incoming().ownerUid == uid() && incoming().ownerName == get(userPath()).data.displayName && incoming().refId == '' && str(incoming().createdAt, 40) && incoming().get('audience', 'all') == 'all' && !incoming().keys().hasAny(['participants','reminder','remindAt','reminderSentAt']);}
   allow get: if isManager() || (isStaff() && resource.data.get('audience', 'all') == 'all');
   allow list: if isManager() || (isStaff() && resource.data.audience == 'all');
   allow create: if calendarShape() && (isManager() || createsPresence());
   allow update: if calendarShape() && (isManager() || (ownsPresence() && incoming().get('audience', 'all') == 'all' && changed().hasOnly(['title','date','time','from','to','note','audience'])));
   allow delete: if isManager() || ownsPresence();
  }
  // B1-B4, D3, Q25-Q26: broadcasts. Managers send, to the team or outside it (an event's registrants, vendors, users who agreed
  // to updates); a recipient (staff, vendor or guest) reads the ones addressed to them and writes only their own receipt
  match /broadcasts/{bid} {
   function shape(){return incoming().keys().hasOnly(['id','text','audience','eventId','urgent','by','createdAt','recipients','recipientCount','resentAt']) && incoming().id == bid && str(incoming().text, 200) && incoming().text.size() >= 1 && incoming().audience in ['all','farmToday','managers','crew','vendors','registrants','everyone'] && str(incoming().get('eventId', ''), 60) && incoming().urgent is bool && incoming().recipients is list && incoming().recipients.size() <= 2000 && incoming().recipientCount == incoming().recipients.size() && isoTime(incoming().createdAt);}
   allow get, list: if isManager() || (signed() && uid() in resource.data.recipients);
   allow create: if isManager() && shape() && actorOk(incoming().by) && incoming().resentAt == null;
   allow update: if isManager() && changed().hasOnly(['resentAt']) && isoTime(incoming().resentAt);
   allow delete: if isOwner();
   // the read receipt: only the person themselves, only as a recipient; once read it stays read
   match /reads/{rid} {
    function receiptOk(){return incoming().keys().hasOnly(['id','uid','name','at','seenAt']) && incoming().uid == rid && incoming().id == rid && str(incoming().name, 80) && (incoming().get('at', null) == null || isoTime(incoming().at)) && (!('seenAt' in incoming()) || isoTime(incoming().seenAt));}
    function recipient(){return uid() in getAfter(/databases/$(database)/documents/broadcasts/$(bid)).data.recipients;}
    allow get: if self(rid) || isManager();
    allow list: if isManager();
    allow create: if self(rid) && receiptOk() && recipient();
    allow update: if self(rid) && receiptOk() && (resource.data.get('at', null) == null || incoming().get('at', null) != null);
    allow delete: if false;
   }
  }
  // the push outbox: the app creates jobs, only the Worker (service account) reads and updates them
  match /push_jobs/{jid} {
   allow read: if false;
   allow create: if !jid.matches('op_.*') && incoming().keys().hasOnly(['id','kind','title','body','link','to','createdBy','createdAt','sentAt','urgent','tag','refId','includeSelf']) && incoming().id == jid && actorOk(incoming().createdBy) && incoming().sentAt == null && incoming().kind in ['task','urgent','trip','event','broadcast','vendor','system'] && str(incoming().title, 80) && str(incoming().body, 180) && str(incoming().link, 200) && incoming().link.matches('/([^/].*)?') && str(incoming().tag, 64) && str(incoming().get('refId', ''), 80) && isoTime(incoming().createdAt) && incoming().to is list && incoming().to.size() >= 1 && incoming().to.size() <= 200 && incoming().get('includeSelf', false) is bool && incoming().urgent is bool
     && ((isStaff() && (!(incoming().kind in ['broadcast','system']) || isManager())) || (isVendor() && incoming().kind == 'vendor'));
   allow update, delete: if false;
  }
 }
}
