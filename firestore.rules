  // managers see each payment's state. "לשלוח גם במייל" (Q26): a manager queues bc_<broadcastId>_<uid>, one per recipient of a
  // broadcast they sent, in this exact shape and nothing else; the Worker reads the text from the broadcast and sends it.
  // No nextAt: the payment lane's query (status + nextAt) never sees these jobs, so they cannot crowd a confirmation out.
  match /email_outbox/{id} {
   function bcAfter(){return getAfter(/databases/$(database)/documents/broadcasts/$(incoming().broadcastId)).data;}
   function mailJob(){return incoming().keys().hasOnly(['kind','broadcastId','uid','status','createdBy','createdAt']) && incoming().kind == 'broadcast' && incoming().status == 'queued'
     && str(incoming().broadcastId, 60) && incoming().broadcastId.matches('[A-Za-z0-9_-]+') && str(incoming().uid, 128) && incoming().uid.matches('[A-Za-z0-9_-]+')
     && id == 'bc_' + incoming().broadcastId + '_' + incoming().uid && actorOk(incoming().createdBy) && isoTime(incoming().createdAt)
