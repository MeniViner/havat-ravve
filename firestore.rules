   function catalogShape(){return incoming().keys().hasOnly(['name','createdAt','updatedAt','archived','generation']) && str(incoming().name, 120) && incoming().name.size() > 0 && catalogEntryTimes();}
   allow get: if isStaff();
   allow list: if isManager();
