    allow read: if isManager() || (isStaff() && get(/databases/$(database)/documents/projects/$(pid)).data.get('eventId', '') != '');
    allow create: if isManager() && stepShape() && incoming().done == false && incoming().get('doneBy', null) == null && incoming().get('doneAt', null) == null && incoming().get('updates', []).size() == 0 && actorOk(incoming().createdBy) && str(incoming().createdAt, 40);
    allow update: if isManager() && stepShape() && changed().hasOnly(['n','title','assignee','due','note','done','doneBy','doneAt','updates','updatedAt']) && doneOk() && updatesOk();
