    function parentActive(){return !getAfter(/databases/$(database)/documents/farm_catalogs/$(catalog)).data.get('archived', false);}
    function masterShape(){return incoming().keys().hasOnly(['name','price','createdAt','updatedAt','archived','generation']) && str(incoming().name, 200) && incoming().name.size() > 0 && incoming().price is number && incoming().price >= 0 && catalogEntryTimes();}
    allow get: if isStaff();
