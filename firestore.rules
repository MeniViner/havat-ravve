   allow delete: if isOwner();
   match /steps/{sid} {
    function stepShape(){return incoming().keys().hasOnly(['id','projectId','n','title','assignee','due','note','done','doneBy','doneAt','parentId','updates','createdBy','createdAt','updatedAt']) && incoming().get('id', sid) == sid && incoming().projectId == pid && incoming().n is number && str(incoming().title, 200) && incoming().title.size() > 0 && str(incoming().get('note', ''), 1000) && str(incoming().get('due', ''), 10) && (incoming().get('assignee', null) == null || actorMap(incoming().assignee)) && (incoming().get('parentId', null) == null || str(incoming().parentId, 80)) && incoming().done is bool && incoming().get('updates', []) is list && incoming().get('updates', []).size() <= 300 && str(incoming().updatedAt, 40);}
    // "בוצע" is stamped by the person marking it, once: a late second "done" from another phone is refused
