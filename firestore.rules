   // a managers-only task logs as 'task_private': not a team kind, so no volunteer query (by refId, kind, actor or subject) can return it
   function teamKind(){return resource.data.kind in ['task','shopping','event','ticket','tab','place','message','calendar'];}
   allow read: if isManager() || (isStaff() && teamKind()) || (mine('subjectUid') && !(resource.data.kind in ['task_private','project','calendar_private','inbox']));
   // D7 reads this receipt on the server. Old rules refuse the read before any removal is attempted.
   allow get: if helperInviteCode(id) && exists(vendorInvitePath(id)) && get(vendorInvitePath(id)).data.role == 'helper'
      && vendorOwner(get(vendorInvitePath(id)).data.vendorId);
   function helperRemovalLog(){
    return incoming().kind == 'event' && incoming().action == 'removed'
      && incoming().refId == get(vendorInvitePath(id)).data.vendorId
      && helperRemovedFrom(incoming().refId, id);
   }
   function joinedInBatch(){return google() && incoming().kind == 'user' && incoming().action == 'joined'
