        && str(incoming().moving.from,140) && incoming().moving.from.size()>0 && str(incoming().moving.to,140)
        && incoming().moving.from != incoming().moving.to && isoTime(incoming().moving.startedAt)));
  }
  function catalogEntryTimes() {
   return isoTime(incoming().createdAt) && isoTime(incoming().updatedAt) && incoming().get('archived', false) is bool
    && incoming().get('generation',0) is int && incoming().get('generation',0) >= 0;
  }
  function catalogEditAllowed() {
   let before = resource.data.get('archived',false);
