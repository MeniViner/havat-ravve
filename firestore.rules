   function camera(c){return point(c) && c.keys().hasOnly(['lat','lng','zoom']) && c.zoom is number && c.zoom >= 0 && c.zoom <= 22;}
   function setup(s){return s is map && s.keys().hasOnly(['entrance','placeId','trailId']) && point(s.entrance)
