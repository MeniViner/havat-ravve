rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function google(){return request.auth != null && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com';}
  function owner(){return google() && request.auth.token.email == 'meniviner@gmail.com';}
  function member(){return google() && exists(/databases/$(database)/documents/cms_admins/$(request.auth.token.email)) && get(/databases/$(database)/documents/cms_admins/$(request.auth.token.email)).data.active == true && get(/databases/$(database)/documents/cms_admins/$(request.auth.token.email)).data.uid == request.auth.uid;}
  function editor(){return owner() || member();}
  function contentValid(){return request.resource.data.keys().hasOnly(['data','revision','updated_at','updated_by']) && request.resource.data.data is map && request.resource.data.data.keys().hasOnly(['values','events','position']) && request.resource.data.data.values is map && request.resource.data.data.events is list && request.resource.data.data.events.size() <= 100 && request.resource.data.data.position in ['story','heritage','experiences','visit'] && request.resource.data.revision is int && request.resource.data.updated_by == request.auth.token.email && request.resource.data.updated_at is string;}
  function publicationValid(name){return name == 'draft' || (getAfter(/databases/$(database)/documents/cms_state/draft).data.data == request.resource.data.data);}
  match /cms_state/{name} {
   allow read: if name == 'published' || editor();
   allow create: if editor() && name in ['draft','published'] && contentValid() && request.resource.data.revision == 1 && publicationValid(name);
   allow update: if editor() && name in ['draft','published'] && contentValid() && request.resource.data.revision == resource.data.revision + 1 && publicationValid(name);
  }
  match /cms_admins/{email} {
   allow get: if owner() || (google() && email == request.auth.token.email);
   allow list: if owner();
   allow create: if owner() && request.resource.data.keys().hasOnly(['email','uid','role','active','created_at']) && request.resource.data.email == email && request.resource.data.role == 'editor' && request.resource.data.active is bool && request.resource.data.uid == null;
   allow update: if (owner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']) && request.resource.data.active is bool) || (google() && request.auth.token.email == email && resource.data.active == true && resource.data.uid == null && request.resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']));
  }
  match /cms_history/{id} {
   allow read: if editor();
   allow create: if editor() && request.resource.data.keys().hasOnly(['data','name','revision','created_at','actor']) && request.resource.data.name in ['draft','published'] && request.resource.data.actor == request.auth.token.email && request.resource.data.data == get(/databases/$(database)/documents/cms_state/$(request.resource.data.name)).data.data && request.resource.data.revision == get(/databases/$(database)/documents/cms_state/$(request.resource.data.name)).data.revision;
  }
  match /cms_media/{id} {
   allow get: if true;
   allow list: if editor();
   allow create: if editor() && request.resource.data.keys().hasOnly(['key','name','type','size','created_at','actor','dataUrl']) && request.resource.data.key == id && request.resource.data.actor == request.auth.token.email && request.resource.data.type == 'image/webp' && request.resource.data.name is string && request.resource.data.name.size() < 250 && request.resource.data.size is int && request.resource.data.size <= 450000 && request.resource.data.dataUrl is string && request.resource.data.dataUrl.size() <= 650000 && request.resource.data.dataUrl.matches('data:image/webp;base64,[A-Za-z0-9+/=]+');
  }

  // ---------- Team app (users, tasks, shopping) ----------
  // Roles (users/{uid}.role, counted only while status == 'active'): owner > manager > staff; vendor (a stall's owner or helper,
  // never staff); guest; and blocked (status). docs/redesign-data/rules.md lists who reads and writes each collection.
  function uid(){return request.auth.uid;}
  function self(id){return google() && id == uid();}
  function userPath(){return /databases/$(database)/documents/users/$(uid());}
  function bootstrapOwner(){return request.auth.token.email == 'meniviner@gmail.com';}
  function activeRole(){return exists(userPath()) && get(userPath()).data.status == 'active' ? get(userPath()).data.role : 'none';}
  function isOwner(){return google() && (bootstrapOwner() || activeRole() == 'owner');}
  function isManager(){return google() && (bootstrapOwner() || activeRole() in ['owner','manager']);}
  function isStaff(){return google() && (bootstrapOwner() || activeRole() in ['owner','manager','staff']);}
  // ---------- vendors: a stall's owner and helpers (role 'vendor', users/{uid}.vendorId) ----------
  // kept small on purpose: Firestore stops a rule after 1000 evaluated expressions, and the record update has five branches
  function vendorMe(){return get(userPath()).data;}
  function isVendor(){return google() && exists(userPath()) && vendorMe().role == 'vendor' && vendorMe().status == 'active';}
  function myVendor(){return isVendor() ? vendorMe().get('vendorId', '') : '';}
  function vendorPerson(vid){return vid is string && vid != '' && isVendor() && vendorMe().get('vendorId', '') == vid;}
  function vendorOwner(vid){return vendorPerson(vid) && vendorMe().get('helper', false) == false;}
  function vendorInvitePath(code){return /databases/$(database)/documents/vendor_invites/$(code);}
  function stallPath(vid){return /databases/$(database)/documents/vendors/$(vid);}
  function profilePath(id){return /databases/$(database)/documents/users/$(id);}
  function removalLogPath(code){return /databases/$(database)/documents/activity/$(code);}
  function helperInviteCode(code){return code is string && code.matches('[a-z0-9-]{8,40}');}
  function stallRows(v){return v.get('people', []);}
  function helperRowRemoved(before, after, code){
   let missing = before.removeAll(after);
   return after.size() + 1 == before.size() && missing.size() == 1
      && missing[0].get('code', '') == code && missing[0].role == 'helper'
      && after == before.removeAll(missing);
  }
  function helperRemovedFrom(vid, code){
   return helperRowRemoved(stallRows(get(stallPath(vid)).data), stallRows(getAfter(stallPath(vid)).data), code);
  }
  function helperLinked(profile, vid, code){
   return profile.role == 'vendor' && profile.get('helper', false) == true
     && profile.get('vendorId', '') == vid && profile.get('inviteCode', '') == code;
  }
  function helperAccountClosed(id, vid, code){
   let path = profilePath(id);
   return !exists(path) || !helperLinked(get(path).data, vid, code) || getAfter(path).data.role == 'guest';
  }
  function helperInviteClosed(code, vid, rowUid){
   let path = vendorInvitePath(code);
   let inv = get(path).data;
   let claimant = inv.usedBy;
   let after = getAfter(path).data;
   return inv.code == code && inv.vendorId == vid && inv.role == 'helper' && after.active == false
     && after.diff(inv).affectedKeys().hasOnly(['active'])
     && (claimant == null || rowUid == '' || claimant == rowUid)
     && (claimant != null ? helperAccountClosed(claimant, vid, code)
       : (rowUid == '' || helperAccountClosed(rowUid, vid, code)));
  }
  function invitedTo(eid){return isVendor() && vendorMe().get('vendorId', '') != '' && exists(/databases/$(database)/documents/events/$(eid)/vendors/$(vendorMe().get('vendorId', '')));}
  function str(v, max){return v is string && v.size() <= max;}
  function actorOk(a){return a is map && a.keys().hasOnly(['uid','name']) && a.uid == uid() && str(a.name, 80);}
  // an Actor that is not necessarily the writer (the person a task or step is put on)
  function actorMap(a){return a is map && a.keys().hasOnly(['uid','name']) && str(a.uid, 128) && a.uid.size() > 0 && str(a.name, 80);}
  // a photo stored in R2 by the farm's Worker (api/src/files.ts): only that host, only its key shape
  function storedPhoto(v){return v is string && v.size() <= 300 && v.matches('https://havat-ravve-api[.]meniviner[.]workers[.]dev/v1/files/(avatar|task|shopping|place|event|eventfile|stall)/[A-Za-z0-9_-]{1,128}/[A-Za-z0-9_-]{32}[.](jpg|webp|png)');}
  function photoOk(v){return v == '' || storedPhoto(v) || (v is string && v.size() <= 400000 && v.matches('data:image/(webp|jpeg);base64,[A-Za-z0-9+/=]+'));}
  function inviteValid(code){return code is string && exists(/databases/$(database)/documents/invites/$(code)) && get(/databases/$(database)/documents/invites/$(code)).data.active == true && get(/databases/$(database)/documents/invites/$(code)).data.role == 'staff';}
  function incoming(){return request.resource.data;}
  function changed(){return request.resource.data.diff(resource.data).affectedKeys();}
  function isoTime(v){return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z');}
  // optional ISO field: absent, null, or an ISO instant
  function optIso(field){return incoming().get(field, null) == null || isoTime(incoming().get(field, null));}
  // event day: gate and stall writes by the crew stop once a manager closed the event (Y5); managers keep writing
  function eventOpen(eid){return eid is string && eid != '' && exists(/databases/$(database)/documents/events/$(eid)) && get(/databases/$(database)/documents/events/$(eid)).data.get('closed', null) == null;}

  match /users/{id} {
   // vendor keys (vendorId, helper, addedBy, inviteCode) are written only by a claim; photo, town, birthDate, push, welcomedAt and
   // updatesOptIn ("לקבל עדכונים מהחווה", the consent a message to all users needs) only by the person
   function profileShape(){return incoming().keys().hasOnly(['uid','email','displayName','phone','role','status','customerNumber','acceptedTermsAt','joinCode','notes','fields','log','createdAt','updatedAt','vendorId','helper','addedBy','inviteCode','teamLink','photo','photoSource','googlePhoto','town','birthDate','birthYear','push','welcomedAt','updatesOptIn']) && incoming().uid == id && str(incoming().email, 200) && str(incoming().displayName, 80) && incoming().displayName.size() >= 1 && str(incoming().phone, 25) && incoming().customerNumber is int && str(incoming().acceptedTermsAt, 40) && str(incoming().createdAt, 40) && str(incoming().updatedAt, 40) && str(incoming().get('vendorId', ''), 60) && incoming().get('helper', false) is bool && str(incoming().get('addedBy', ''), 60) && str(incoming().get('inviteCode', ''), 40) && str(incoming().get('teamLink', ''), 40) && ownShapeOk();}
   function ownShapeOk(){return (!('photo' in incoming()) || storedPhoto(incoming().photo) || (str(incoming().photo, 120000) && incoming().photo.matches('data:image/(jpeg|webp|png);base64,[A-Za-z0-9+/=]+'))) && incoming().get('photoSource', 'none') in ['custom','google','none'] && (!('googlePhoto' in incoming()) || (str(incoming().googlePhoto, 500) && incoming().googlePhoto.matches('https://.*'))) && str(incoming().get('town', ''), 60) && (incoming().get('birthDate', '') == '' || incoming().get('birthDate', '').matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')) && (!('push' in incoming()) || pushOk()) && (!('welcomedAt' in incoming()) || str(incoming().welcomedAt, 40)) && incoming().get('updatesOptIn', false) is bool;}
   // Reuse older profiles unchanged; only a new registration or a change to the year needs a new selection.
   function validBirthYear(){let year=incoming().get('birthYear', 0); return year is int && year >= 1900 && year <= request.time.year();}
   function pushOk(){let p = incoming().push; return p is map && p.keys().hasOnly(['enabled','kinds','devices','updatedAt']) && p.get('enabled', false) is bool && p.get('kinds', []) is list && p.get('kinds', []).size() <= 10 && p.get('devices', []) is list && p.get('devices', []).size() <= 6 && str(p.get('updatedAt', ''), 40);}
   // a vendor profile is written only in the commit that uses up a matching invite (claimVendorInvite)
   function inviteBefore(){return get(/databases/$(database)/documents/vendor_invites/$(incoming().inviteCode)).data;}
   function inviteAfter(){return getAfter(/databases/$(database)/documents/vendor_invites/$(incoming().inviteCode)).data;}
   function claimsInvite(){return incoming().role == 'vendor' && incoming().get('inviteCode', '') is string && incoming().get('inviteCode', '').size() >= 8 && inviteBefore().active == true && inviteBefore().usedBy == null && inviteAfter().usedBy == id && inviteAfter().active == false && incoming().vendorId == inviteBefore().vendorId && incoming().helper == (inviteBefore().role == 'helper') && incoming().addedBy == inviteBefore().createdBy.uid;}
   function emailInvite(){return get(/databases/$(database)/documents/role_invites/$(request.auth.token.email)).data;}
   function hasEmailInvite(){return exists(/databases/$(database)/documents/role_invites/$(request.auth.token.email));}
   // Q27: a team role from a one-time link (team_links/{code}), only in the commit that uses the link up: active, unused, not
   // expired before; used by this account after. The phone typed on the link is a label and plays no part here.
   function linkBefore(){return get(/databases/$(database)/documents/team_links/$(incoming().teamLink)).data;}
   function linkAfter(){return getAfter(/databases/$(database)/documents/team_links/$(incoming().teamLink)).data;}
   function claimsTeamLink(){return incoming().get('teamLink', '') is string && incoming().get('teamLink', '').size() >= 8 && linkBefore().active == true && linkBefore().usedBy == null && request.time.toMillis() < linkBefore().expiresMs && linkAfter().usedBy == id && linkAfter().active == false && incoming().role == linkBefore().role;}
   function createRole(){return incoming().status == 'active' && ((incoming().role == 'guest') || (incoming().role == 'owner' && bootstrapOwner()) || (hasEmailInvite() && incoming().role == emailInvite().role && incoming().role in ['staff','manager','owner']) || claimsInvite() || (incoming().role in ['staff','manager','owner'] && claimsTeamLink()));}
   // the person's own details; never role, status, email, customerNumber, notes, log or the vendor link
   function selfEdit(){return changed().hasOnly(['displayName','phone','acceptedTermsAt','fields','updatedAt','photo','photoSource','googlePhoto','town','birthDate','birthYear','push','welcomedAt','updatesOptIn']) && str(incoming().displayName, 80) && incoming().displayName.size() >= 1 && str(incoming().phone, 25);}
   // a vendor stays a vendor (status, notes); a manager never makes one: only a claim can (V6 sets the role back to guest)
   function managerEdit(){return changed().hasOnly(['role','status','notes','updatedAt','log']) && (incoming().role in ['guest','staff','manager','owner'] || (incoming().role == 'vendor' && resource.data.role == 'vendor')) && incoming().status in ['active','pending','blocked'] && str(incoming().notes, 2000) && (resource.data.role != 'owner' || isOwner()) && (incoming().role != 'owner' || isOwner()) && (incoming().role != 'manager' || isOwner() || resource.data.role == 'manager');}
   function claimEdit(){return self(id) && resource.data.role in ['guest','vendor'] && resource.data.status == 'active' && changed().hasOnly(['role','vendorId','helper','addedBy','inviteCode','updatedAt']) && claimsInvite();}
   // Q27: an active guest account that opens a team link gets the link's role, once
   function teamClaimEdit(){return self(id) && resource.data.role == 'guest' && resource.data.status == 'active' && changed().hasOnly(['role','teamLink','updatedAt']) && claimsTeamLink();}
   allow get: if self(id) || isManager();
   // volunteers need the names of the team (who a task is on), never the guests
   allow list: if isManager() || (isStaff() && resource.data.role in ['owner','manager','staff']);
   function fieldsOk(){return incoming().get('fields', {}) is map && incoming().get('fields', {}).get('receiptPreference', '') in ['', 'whatsapp', 'email'];}
   allow create: if self(id) && validBirthYear() && profileShape() && fieldsOk() && incoming().email == request.auth.token.email && createRole() && (incoming().role == 'vendor' || !incoming().keys().hasAny(['vendorId','helper','addedBy','inviteCode']));
   function revokedHelper(vid, code){
    let invPath = vendorInvitePath(code);
    let claimant = get(invPath).data.get('usedBy', null);
    let before = stallRows(get(stallPath(vid)).data);
    let after = stallRows(getAfter(stallPath(vid)).data);
    return helperRowRemoved(before, after, code) && getAfter(invPath).data.active == false
      && (claimant == null ? before.removeAll(after)[0].get('uid', '') == id : claimant == id);
   }
   function helperRevoke(){
    let vid = resource.data.get('vendorId', '');
    let code = resource.data.get('inviteCode', '');
    return changed().hasOnly(['role','updatedAt']) && isoTime(incoming().updatedAt)
      && helperInviteCode(code) && vendorOwner(vid)
      && revokedHelper(vid, code);
   }
   // The removal only changes role and time. All other profile fields stay byte-for-byte unchanged.
   allow update: if (resource.data.role == 'vendor' && incoming().role == 'guest'
      && resource.data.get('helper', false) == true && helperRevoke()) || (profileShape() && incoming().email == resource.data.email && ((self(id) && selfEdit() && (!changed().hasAny(['birthYear']) || validBirthYear()) && (!changed().hasAny(['fields']) || fieldsOk())) || (isManager() && managerEdit()) || claimEdit() || teamClaimEdit()));
   allow delete: if isOwner();

   // C1: personal notifications. Only the person reads them; the team (and a vendor, to the team) writes them through notify()
   match /notifications/{nid} {
    function noteShape(){return incoming().keys().hasOnly(['id','kind','title','sub','link','refId','action','by','createdAt','readAt']) && incoming().id == nid && incoming().kind in ['task','urgent','trip','event','broadcast','vendor','system'] && str(incoming().title, 120) && str(incoming().sub, 240) && str(incoming().link, 200) && incoming().link.matches('/([^/].*)?') && str(incoming().get('refId', ''), 80) && (!('action' in incoming()) || (incoming().action is map && incoming().action.keys().hasOnly(['label','kind']) && str(incoming().action.label, 40) && incoming().action.kind in ['addToTrip','open'])) && isoTime(incoming().createdAt);}
    function sender(){return actorOk(incoming().by) && ((isStaff() && (!(incoming().kind in ['broadcast','system']) || isManager())) || (isVendor() && incoming().kind == 'vendor' && (self(id) || get(/databases/$(database)/documents/users/$(id)).data.role in ['owner','manager','staff'])));}
    allow read: if self(id);
    allow create: if !nid.matches('op_.*') && noteShape() && incoming().readAt == null && sender();
    // the owner of the list only marks read; "לשלוח שוב" rewrites b_<id> as new (a manager overwrites a broadcast notification)
    allow update: if (self(id) && changed().hasOnly(['readAt']) && isoTime(incoming().readAt)) || (isManager() && noteShape() && resource.data.kind == 'broadcast' && incoming().kind == 'broadcast' && incoming().readAt == null && actorOk(incoming().by));
    allow delete: if self(id);
   }
  }
  // Account deletion request: the person themselves, stamped with the server's time. The Worker removes the
  // account after 30 days (api/src/accounts.ts); until then deleting this document cancels the request.
  match /account_deletions/{id} {
   allow get: if self(id) || isManager();
   allow list: if isManager();
   allow create: if self(id) && !isOwner() && incoming().keys().hasOnly(['uid','email','requestedAt']) && incoming().keys().hasAll(['uid','email','requestedAt']) && incoming().uid == id && incoming().email == request.auth.token.email && incoming().requestedAt == request.time;
   allow update: if false;
   allow delete: if self(id) || isManager();
  }
  match /counters/{name} {
   allow read: if google();
   allow create: if google() && name == 'users' && incoming().keys().hasOnly(['value']) && incoming().value == 1;
   allow update: if google() && name == 'users' && incoming().keys().hasOnly(['value']) && incoming().value == resource.data.value + 1;
  }
  match /role_invites/{email} {
   allow read: if isManager() || (google() && request.auth.token.email == email);
   allow create, update: if isManager() && incoming().keys().hasOnly(['email','role','createdBy','createdAt']) && incoming().email == email && incoming().role in ['staff','manager','owner'] && (incoming().role != 'owner' || isOwner()) && (incoming().role != 'manager' || isOwner()) && actorOk(incoming().createdBy) && str(incoming().createdAt, 40);
   allow delete: if isManager();
  }
  // Q27 "להוסיף מישהו מראש" by phone: a one-time link a manager sends in WhatsApp (src/app/v2/data/invite.ts). Same rules as
  // role_invites for who may give which role; used once (claimsTeamLink in users), good for at most 15 days; cancel deletes it.
  match /team_links/{code} {
   function linkShape(){return incoming().keys().hasOnly(['code','role','name','phone','fem','active','usedBy','usedAt','createdBy','createdAt','expiresMs']) && incoming().code == code && code.matches('t-[a-z0-9]{12,30}') && incoming().role in ['staff','manager','owner'] && str(incoming().name, 80) && str(incoming().phone, 25) && incoming().phone.size() >= 9 && incoming().get('fem', false) is bool && incoming().active is bool && isoTime(incoming().createdAt) && incoming().expiresMs is int;}
   allow get: if google();
   allow list: if isManager();
   allow create: if isManager() && linkShape() && actorOk(incoming().createdBy) && incoming().active == true && incoming().usedBy == null && incoming().usedAt == null && (incoming().role != 'owner' || isOwner()) && (incoming().role != 'manager' || isOwner()) && incoming().expiresMs > request.time.toMillis() && incoming().expiresMs <= request.time.toMillis() + 15 * 86400000;
   // the claim: only in the commit that gives this account the link's role (users claimsTeamLink checks the other side)
   allow update: if linkShape() && google() && resource.data.active == true && resource.data.usedBy == null && request.time.toMillis() < resource.data.expiresMs && changed().hasOnly(['usedBy','usedAt','active']) && incoming().usedBy == uid() && incoming().active == false && isoTime(incoming().usedAt) && getAfter(userPath()).data.get('teamLink', '') == code && getAfter(userPath()).data.role == resource.data.role;
   allow delete: if isManager();
  }
  match /invites/{code} {
   function inviteShape(){return incoming().keys().hasOnly(['code','role','active','createdBy','createdAt','usedBy']) && incoming().code == code && incoming().role == 'staff' && incoming().active is bool && str(incoming().createdAt, 40) && incoming().usedBy is list;}
   allow read: if isManager();
   allow create: if isManager() && inviteShape() && actorOk(incoming().createdBy) && code.size() >= 4 && code.size() <= 12;
   allow update: if (isManager() && inviteShape() && changed().hasOnly(['active','usedBy'])) || (google() && changed().hasOnly(['usedBy']) && incoming().usedBy.size() == resource.data.usedBy.size() + 1 && incoming().usedBy[resource.data.usedBy.size()] == uid());
   allow delete: if isManager();
  }
  match /tasks/{id} {
   function taskShape(){return incoming().keys().hasOnly(['title','note','photo','location','dueDate','managersOnly','templateId','dateKey','createdBy','createdAt','done','doneBy','doneAt','donePhoto','doneNote','updatedAt','assignee','urgent','eventId','takenAt','shoppingId','requestedBy']) && str(incoming().get('eventId', ''), 60) && str(incoming().get('takenAt', ''), 40) && str(incoming().get('shoppingId', ''), 80) && (!('requestedBy' in incoming()) || actorMap(incoming().requestedBy)) && str(incoming().title, 200) && (incoming().assignee == null || (incoming().assignee is map && incoming().assignee.keys().hasOnly(['uid','name']) && str(incoming().assignee.name, 80))) && incoming().urgent is bool && incoming().title.size() >= 1 && str(incoming().note, 4000) && photoOk(incoming().photo) && (incoming().location == null || (incoming().location is map && incoming().location.lat is number && incoming().location.lng is number)) && str(incoming().dueDate, 10) && incoming().managersOnly is bool && (incoming().templateId == null || (str(incoming().templateId, 60) && str(incoming().dateKey, 10) && id == incoming().templateId + '_' + incoming().dateKey)) && incoming().done is bool && photoOk(incoming().donePhoto) && str(incoming().doneNote, 2000) && str(incoming().createdAt, 40) && str(incoming().updatedAt, 40) && (incoming().managersOnly == false || isManager());}
   function doneShape(){return (incoming().done == false && incoming().doneBy == null && incoming().doneAt == null) || (incoming().done == true && actorOk(incoming().doneBy) && str(incoming().doneAt, 40)) || (incoming().done == true && incoming().doneBy == resource.data.doneBy && incoming().doneAt == resource.data.doneAt);}
   function canSee(){return isStaff() && (resource.data.managersOnly == false || isManager());}
   // take / release / hand on, for a volunteer who did not create the task: a free open task only to themselves, and only
   // their own task to anyone or back to free. A late offline take of a task someone else took meanwhile is refused (X1).
   function assigneeOk(){let was = resource.data.get('assignee', null); return !changed().hasAny(['assignee']) || (was == null && resource.data.done == false && incoming().assignee != null && incoming().assignee.uid == uid()) || (was != null && was.uid == uid());}
   allow read: if canSee();
   allow create: if isStaff() && taskShape() && actorOk(incoming().createdBy) && incoming().done == false && incoming().doneBy == null && incoming().doneAt == null && incoming().donePhoto == '' && incoming().doneNote == '';
   allow update: if canSee() && taskShape() && incoming().createdBy == resource.data.createdBy && incoming().createdAt == resource.data.createdAt && incoming().templateId == resource.data.templateId && doneShape() && (isManager() || resource.data.createdBy.uid == uid() || (changed().hasOnly(['done','doneBy','doneAt','donePhoto','doneNote','updatedAt','assignee','takenAt','photo','shoppingId']) && assigneeOk()));
   allow delete: if canSee() && (isManager() || resource.data.createdBy.uid == uid());
  }
  match /task_templates/{id} {
   function templateShape(){return incoming().keys().hasOnly(['title','note','days','time','active','managersOnly','createdBy','createdAt','updatedAt','assignee','placeId','skip']) && str(incoming().title, 200) && incoming().title.size() >= 1 && str(incoming().note, 4000) && incoming().days is list && incoming().days.size() <= 7 && str(incoming().time, 5) && incoming().active is bool && incoming().managersOnly is bool && str(incoming().createdAt, 40) && str(incoming().updatedAt, 40) && (incoming().get('assignee', null) == null || actorMap(incoming().assignee)) && str(incoming().get('placeId', ''), 80) && (!('skip' in incoming()) || (incoming().skip is list && incoming().skip.size() <= 30));}
   allow read: if isStaff() && (resource.data.managersOnly == false || isManager());
   allow create: if isManager() && templateShape() && actorOk(incoming().createdBy);
   allow update: if isManager() && templateShape() && incoming().createdBy == resource.data.createdBy;
   allow delete: if isManager();
  }
  function shoppingCategory(key){
   return key in ['super','building','online','giveaway'] || (key is string && key.matches('custom_[A-Za-z0-9_-]{1,320}') && existsAfter(/databases/$(database)/documents/shopping_categories/$(key)));
  }
  match /shopping_categories/{id} {
   allow read: if isStaff();
   function categoryOk(){return incoming().keys().hasOnly(['name']) && str(incoming().name, 60) && incoming().name.size() > 0
     && id == 'custom_' + incoming().name.toUtf8().toBase64().replace('=+$', '').replace('[+]', '-').replace('/', '_');}
   allow create: if isStaff() && categoryOk();
   allow update: if isStaff() && incoming() == resource.data;
  }
  match /shopping/{id} {
   function itemShape(){return incoming().keys().hasOnly(['title','note','link','photo','category','createdBy','createdAt','bought','boughtBy','boughtAt','expireAt','updatedAt','qty','urgent','urgentDueAt','taskId','notAvailable','notAvailableAt','tripId','foundWhere']) && photoOk(incoming().get('photo','')) && str(incoming().get('taskId', ''), 80) && incoming().get('notAvailable', false) is bool && optStr('notAvailableAt', 40) && str(incoming().get('tripId', ''), 80) && str(incoming().get('foundWhere', ''), 200) && str(incoming().qty, 40) && incoming().urgent is bool && str(incoming().title, 200) && incoming().title.size() >= 1 && str(incoming().note, 1000) && str(incoming().link, 2000) && (incoming().link == '' || incoming().link.matches('https://.*')) && shoppingCategory(incoming().category) && optIso('urgentDueAt') && incoming().bought is bool && str(incoming().createdAt, 40) && str(incoming().updatedAt, 40) && ((incoming().bought == false && incoming().boughtBy == null && incoming().boughtAt == null && incoming().expireAt == null) || (incoming().bought == true && incoming().boughtBy is map && str(incoming().boughtAt, 40) && str(incoming().expireAt, 40)));}
   function optStr(field, max){return incoming().get(field, null) == null || str(incoming().get(field, null), max);}
