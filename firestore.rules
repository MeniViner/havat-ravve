  function chunkShape(){let d=incoming();return d.keys().hasOnly(['writer','index','points']) && d.writer==uid() && d.index is int && d.index>=0 && d.points is list && d.points.size()>0 && d.points.size()<=128
    && d.points[0].lat is number && d.points[0].lat >= -90 && d.points[0].lat <= 90 && d.points[0].lng is number && d.points[0].lng >= -180 && d.points[0].lng <= 180;}
  match /surveyRecordings/{sid} {
   allow read: if isOwner();
   allow create: if isOwner() && incoming().keys().hasOnly(['ownerUid','started','count','lastAt','chunks']) && incoming().ownerUid==uid() && incoming().started is int
