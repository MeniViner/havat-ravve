   }
  }
  function applicationDetails(person){return incoming().ownerUid == person && str(incoming().name, 200) && incoming().name.size() > 0
    && str(incoming().phone, 25) && incoming().products is list && incoming().products.size() <= 60 && incoming().needs is list && incoming().needs.size() <= 60
    && isoTime(incoming().createdAt) && isoTime(incoming().updatedAt);}
  match /vendor_applications/{person} {
